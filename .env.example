# ─────────────────────────────────────────────────────────────
# PassPal 配置示例
#
# 用法：复制为 .env 并填写真实值。
# 注意：ADMIN_PASSWORD_HASH 与 DATA_ENCRYPTION_KEY_V1 在 .env.example 中
# 必须留空，任何真实密钥都不允许提交进 Git。
# ─────────────────────────────────────────────────────────────

APP_ENV=production

# 必须与浏览器访问地址完全一致（scheme + host + 可选端口，不能带路径）。
APP_ORIGIN=https://accounts.example.com

# 监听地址：容器内需要 0.0.0.0；裸机部署建议保持 127.0.0.1。
BIND_ADDR=0.0.0.0
PORT=3000

DATABASE_PATH=/app/data/database.sqlite
BACKUP_DIR=/app/backups

# 管理员密码的 Argon2id hash，用 `passpal hash-password` 生成。
# 该值内含 $ 字符：.env 中请用单引号包裹，避免被 shell 展开。
ADMIN_PASSWORD_HASH=

# 数据加密密钥：每个版本 32 字节 base64。
# 生成示例：openssl rand -base64 32
DATA_ENCRYPTION_KEY_V1=
DATA_ENCRYPTION_KEY_CURRENT=1

# 会话有效期（小时）
SESSION_TTL_HOURS=12

# 登录失败限制（按来源）
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# 只信任明确网段的反代转发头；默认留空（直接用 socket 地址）。
# 例：TRUSTED_PROXY_CIDRS=172.16.0.0/12
TRUSTED_PROXY_CIDRS=

# 备份保留天数
BACKUP_RETAIN_DAYS=7
